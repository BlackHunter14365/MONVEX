*.py[cod]
*$py.class
backend/.venv/
.venv/
venv/
env/
ENV/

# Local databases & static assets
*.sqlite3
*.sqlite3-journal
backend/staticfiles/
backend/media/

# Git & IDE metadata
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp
*.swo
*.log

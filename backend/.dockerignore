# Ignore environment variables and sensitive credentials
.env*
!.env.example
*.pem
*.key
*service-account*.json
*credentials*.json

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# Local databases & static assets
*.sqlite3
*.sqlite3-journal
staticfiles/
media/

# Git & IDE metadata
.git/
.gitignore
.github/
.idea/
.vscode/
*.swp
*.swo
*.log

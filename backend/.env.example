# ==============================================================================
# MONVEX Financial Intelligence Platform — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`
# 2. Populate the environment variables below with your deployment credentials.
# 3. NEVER commit `.env` containing live secrets to the Git repository.
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# Production Email Delivery: SMTP-First Architecture
# ------------------------------------------------------------------------------
# Primary email transport using Django SMTP EmailBackend.
# Standard configurations:
# - Port 465: SMTPS with EMAIL_USE_SSL=True and EMAIL_USE_TLS=False
# - Port 587: STARTTLS with EMAIL_USE_TLS=True and EMAIL_USE_SSL=False
# Never set both EMAIL_USE_SSL and EMAIL_USE_TLS to True.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_PROVIDER=smtp
OTP_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=monvexfinance@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
DEFAULT_FROM_EMAIL=MONVEX <monvexfinance@gmail.com>
SERVER_EMAIL=monvexfinance@gmail.com
EMAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# OTP Lifecycle & Verification Policies
# ------------------------------------------------------------------------------
OTP_PROVIDER=smtp
OTP_CHANNEL=email
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
AUTH_REQUIRE_EMAIL_VERIFICATION=True

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# In local development, defaults to SQLite (`db.sqlite3`) if DATABASE_URL is unset.
# In staging/production (e.g. Neon PostgreSQL), provide the Neon connection string:
# DATABASE_URL=postgresql://user:password@ep-cool-dawn-123456.us-east-2.aws.neon.tech/monvex_db?sslmode=require

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://monvex-web.onrender.com,http://localhost:3000,http://127.0.0.1:3000,tauri://localhost
CSRF_TRUSTED_ORIGINS=https://monvex-web.onrender.com,https://monvex-backend.koyeb.app,http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# ------------------------------------------------------------------------------
# External AI & Google SSO Services (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

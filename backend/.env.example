# ==============================================================================
# MONVEX Financial Intelligence Platform — Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`
# 2. Populate the environment variables below with your deployment credentials.
# 3. NEVER commit `.env` containing live secrets to the Git repository.
# ==============================================================================

# Core Django Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# Production Email Delivery: Resend HTTPS Email API (Default for Render)
# ------------------------------------------------------------------------------
# Resend delivers transactional emails via HTTPS (port 443), avoiding cloud SMTP socket blocks.
# Sign up at https://resend.com, generate an API Key, and verify your sending domain.
# For quick testing, you can use RESEND_FROM_EMAIL=MONVEX <onboarding@resend.dev>
EMAIL_PROVIDER=resend
OTP_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=MONVEX <onboarding@resend.dev>
RESEND_TIMEOUT=10

# ------------------------------------------------------------------------------
# Secondary / Local Development SMTP Configuration (Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=monvexfinance@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
SERVER_EMAIL=monvexfinance@gmail.com

# ------------------------------------------------------------------------------
# OTP Lifecycle & Verification Policies
# ------------------------------------------------------------------------------
OTP_PROVIDER=smtp
OTP_CHANNEL=email
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
AUTH_REQUIRE_EMAIL_VERIFICATION=True

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# In local development, defaults to SQLite (`db.sqlite3`) if DATABASE_URL is unset.
# In staging/production, provide a PostgreSQL connection URI:
# DATABASE_URL=postgresql://monvex_user:monvex_password@localhost:5432/monvex_db

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & CSRF Trusted Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://monvex-web.onrender.com,http://localhost:3000,http://127.0.0.1:3000,tauri://localhost
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://monvex-web.onrender.com,http://localhost:3000,http://127.0.0.1:3000,tauri://localhost

# ------------------------------------------------------------------------------
# External AI & Google SSO Services (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

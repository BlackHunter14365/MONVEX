# MONVEX Production Environment Variables
# Copy to .env in production

# Django Core
DEBUG=False
SECRET_KEY=generate_a_secure_64_character_random_secret_key_here
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost

# Database (PostgreSQL)
DB_ENGINE=postgres
DB_NAME=monvex_prod_db
DB_USER=monvex_admin
DB_PASSWORD=replace_with_strong_pg_password
DB_HOST=postgres
DB_PORT=5432

# Redis & Caching
REDIS_URL=redis://redis:6379/0

# AI Copilot (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
SECURE_SSL_REDIRECT=True

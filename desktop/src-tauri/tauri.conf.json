{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "https://monvex-web.onrender.com"
  },
  "package": {
    "productName": "MONVEX",
    "version": "2.0.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "scope": [
          "$DOWNLOAD/*",
          "$DOCUMENT/*",
          "$DESKTOP/*"
        ]
      },
      "globalShortcut": {
        "all": true
      },
      "notification": {
        "all": true
      },
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "close": true,
        "setFocus": true,
        "setTitle": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "category": "Finance",
      "copyright": "\u00a9 2026 MONVEX Financial Technologies",
      "identifier": "com.monvex.desktop",
      "shortDescription": "Personal Financial Intelligence & Decision Support Platform",
      "resources": [
        "WebView2Loader.dll"
      ],
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "webviewInstallMode": {
          "type": "embedBootstrapper"
        }
      },
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "MONVEX \u2014 Financial Intelligence",
        "url": "https://monvex-web.onrender.com",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ]
  }
}
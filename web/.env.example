# =============================================================================
# MONVEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================
# Categorization:
# [SERVER-ONLY] - Sensitive backend secrets. NEVER expose to clients.
# [PUBLIC]      - Public endpoints or client IDs safe for frontend / mobile.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND CORE CONFIGURATION [SERVER-ONLY]
# -----------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=your_production_django_secret_key_here_min_50_chars
ALLOWED_HOSTS=.onrender.com,api.monvex.app,localhost,127.0.0.1
PORT=8000

# -----------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION [SERVER-ONLY]
# -----------------------------------------------------------------------------
# Render PostgreSQL Connection String:
DATABASE_URL=postgresql://monvex_user:your_password@dpg-xxxxx-a.oregon-postgres.render.com/monvex_db
# Or individual fields:
DB_ENGINE=postgres
DB_NAME=monvex_db
DB_USER=monvex_user
DB_PASSWORD=your_db_password
DB_HOST=dpg-xxxxx-a.oregon-postgres.render.com
DB_PORT=5432

# -----------------------------------------------------------------------------
# 3. CORS CONFIGURATION [SERVER-ONLY]
# -----------------------------------------------------------------------------
# Comma-separated list of allowed web frontend origins
CORS_ALLOWED_ORIGINS=https://monvex-web.onrender.com,https://app.monvex.ai,http://localhost:3000,tauri://localhost

# -----------------------------------------------------------------------------
# 4. AI & GEMINI SERVICES [SERVER-ONLY]
# -----------------------------------------------------------------------------
# Google Gemini Pro / Flash API Key (Never shared with browser or mobile)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# -----------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 IDENTITY SERVICES
# -----------------------------------------------------------------------------
# [PUBLIC] Web Client ID
GOOGLE_CLIENT_ID=1068232450695-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# [SERVER-ONLY] Client Secret (Backend token verification)
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# 6. WEB FRONTEND ENVIRONMENT [PUBLIC]
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://monvex-backend.onrender.com/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1068232450695-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=https://github.com/BlackHunter14365/MONVEX/releases/download/v2.0.0/MONVEX-Setup.exe
BACKEND_INTERNAL_URL=http://monvex-backend:8000/api
